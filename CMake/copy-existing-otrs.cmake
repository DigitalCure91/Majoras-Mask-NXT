# Source paths are absolute so this helper also works outside the mm directory.
# On Windows the executable needs 2ship.o2r beside it, not only in the build root.
message(STATUS "Copying generated O2R archives...")
function(copy_o2r source destination)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${source}" "${destination}"
                    RESULT_VARIABLE copied)
    if(NOT copied EQUAL 0)
        message(FATAL_ERROR "Could not copy ${source} to ${destination}")
    endif()
endfunction()
file(MAKE_DIRECTORY "${BINARY_DIR}/mm")
if(SYSTEM_NAME MATCHES "Windows")
    file(MAKE_DIRECTORY "${TARGET_DIR}")
endif()
if(NOT ONLY2SHIPOTR)
    if(NOT EXISTS "${SOURCE_DIR}/mm/mm.o2r")
        message(FATAL_ERROR "No extracted game archive at ${SOURCE_DIR}/mm/mm.o2r")
    endif()
    copy_o2r("${SOURCE_DIR}/mm/mm.o2r" "${SOURCE_DIR}/mm.o2r")
    copy_o2r("${SOURCE_DIR}/mm/mm.o2r" "${BINARY_DIR}/mm/mm.o2r")
    if(SYSTEM_NAME MATCHES "Windows")
        copy_o2r("${SOURCE_DIR}/mm/mm.o2r" "${TARGET_DIR}/mm.o2r")
    endif()
endif()
if(NOT EXISTS "${SOURCE_DIR}/mm/2ship.o2r")
    message(FATAL_ERROR "No generated port archive at ${SOURCE_DIR}/mm/2ship.o2r")
endif()
copy_o2r("${SOURCE_DIR}/mm/2ship.o2r" "${SOURCE_DIR}/2ship.o2r")
copy_o2r("${SOURCE_DIR}/mm/2ship.o2r" "${BINARY_DIR}/mm/2ship.o2r")
if(SYSTEM_NAME MATCHES "Windows")
    copy_o2r("${SOURCE_DIR}/mm/2ship.o2r" "${TARGET_DIR}/2ship.o2r")
endif()
message(STATUS "Generated port archive copied successfully")
