+            gSaveContext.buttonStatus[EQUIP_SLOT_A] = BTN_DISABLED;
+        }
+        pauseCtx->pageIndex = sPageSwitchNextPageIndex[pauseCtx->nextPageMode];
+        pauseCtx->mainState = PAUSE_MAIN_STATE_IDLE;
+        pauseCtx->state++;
+        pauseCtx->alpha = 255;
