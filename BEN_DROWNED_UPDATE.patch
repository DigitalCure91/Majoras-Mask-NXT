+            if (h.choiceAvailable) {
+                DrawText(draw, ImVec2(x + 19.0f * scale, textY + 6.0f * scale), labelFontSize,
+                         Color(191, 162, 123, panelAlpha), "An answer is waiting: Enhancements > BEN DROWNED", textWidth, panelAlpha);
+            }
+        }
+        draw->PopClipRect();
+    }
+    ImGui::End();
+    ImGui::PopStyleVar(2);
+}
