+            if ((category == ACTORCAT_ENEMY || PlayerBots_IsReinforcement(a)) && a->colChkInfo.health &&
+                std::hypot(a->world.pos.x - pos.x, a->world.pos.z - pos.z) < 650.0f &&
+                std::abs(a->world.pos.y - pos.y) < 180.0f) combat = true;
+        }
