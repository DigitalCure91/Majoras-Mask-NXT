+void KaleidoScope_GrayOutTextureRGBA32(u32* texture, u16 pixelCount) {
+    u32 rgb;
+    u32 gray;
+    u16 i;
+    s32 j;
+    if (texture == NULL) {}
+    for (i = 0; i < pixelCount; i++) {
+        j = i;
+        if ((texture[j] & 0xFFFFFF00) != 0) {
+            rgb = texture[j] >> 8;
+            gray = ((((rgb & 0xFF0000) >> 16) + ((rgb & 0xFF00) >> 7) + (rgb & 0xFF)) / 7) & 0xFF;
+            rgb = gray;
+            rgb <<= 8;
+            rgb |= gray;
+            rgb <<= 8;
+            rgb |= gray;
+            texture[j] = (rgb << 8) | (texture[j] & 0xFF);
+        }
+    }
+}
