+            bool threw = false;
+            try { invalid.get_to(original); } catch (const std::exception&) { threw = true; }
+            CHECK(threw && json(original) == saved);
+        }
+        if (std::string(field) != "activeMs") {
+            json invalid = saved; invalid[field] = uint64_t{1} << 32;
+            bool threw = false;
+            try { invalid.get_to(original); } catch (const std::exception&) { threw = true; }
+            CHECK(threw && json(original) == saved);
