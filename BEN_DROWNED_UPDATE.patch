+(out/'headers.cpp').write_text('#include "Rando/CheckTracker/CheckTracker.h"\n#include "Rando/Logic/Logic.h"\nstatic_assert(SCENE_LOAD == 0);\nstatic_assert(SCENE_UPDATE == 1);\n')
